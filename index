<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CodeMotion Studio — Generator Visual Motion & Ekspor MP4</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- MP4 Muxer untuk ekspor MP4 presisi tinggi via WebCodecs -->
  <script src="https://cdn.jsdelivr.net/npm/mp4-muxer@5.1.3/build/mp4-muxer.min.js"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            studio: {
              bg: '#09090b',
              panel: '#121216',
              surface: '#1a1a21',
              border: '#272730',
              accent: '#6366f1',
              accentHover: '#4f46e5',
              cyan: '#06b6d4',
              pink: '#ec4899'
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Custom Scrollbar bertema Studio */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #121216;
    }
    ::-webkit-scrollbar-thumb {
      background: #272730;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #3f3f4e;
    }

    /* Pola papan catur transparan di belakang canvas preview */
    .canvas-backdrop {
      background-color: #0b0b0e;
      background-image: 
        radial-gradient(#23232c 1px, transparent 1px),
        radial-gradient(#23232c 1px, #0b0b0e 1px);
      background-size: 24px 24px;
      background-position: 0 0, 12px 12px;
    }

    /* Styling Timeline Scrubber */
    input[type="range"].timeline-slider {
      -webkit-appearance: none;
      appearance: none;
      background: transparent;
      cursor: pointer;
    }
    input[type="range"].timeline-slider::-webkit-slider-runnable-track {
      height: 6px;
      border-radius: 999px;
    }
    input[type="range"].timeline-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      height: 16px;
      width: 16px;
      border-radius: 50%;
      background: #ffffff;
      border: 3px solid #6366f1;
      margin-top: -5px;
      box-shadow: 0 0 10px rgba(99, 102, 241, 0.8);
      transition: transform 0.15s ease;
    }
    input[type="range"].timeline-slider::-webkit-slider-thumb:hover {
      transform: scale(1.2);
    }

    /* Tab & Line numbers editor */
    .code-editor-area {
      tab-size: 2;
      -moz-tab-size: 2;
      line-height: 1.6;
    }
  </style>
</head>
<body class="bg-studio-bg text-zinc-100 font-sans antialiased h-screen flex flex-col overflow-hidden selection:bg-indigo-500/30 selection:text-indigo-200">

  <!-- TOP HEADER / NAVBAR STUDIO -->
  <header class="h-14 bg-studio-panel border-b border-studio-border px-4 flex items-center justify-between shrink-0 z-20">
    <!-- Brand & Project Title -->
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 via-purple-500 to-cyan-400 flex items-center justify-center shadow-lg shadow-indigo-500/20">
        <i data-lucide="clapperboard" class="w-4 h-4 text-white"></i>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="font-bold text-sm tracking-tight text-white">CodeMotion <span class="text-indigo-400">Studio</span></h1>
          <span class="text-[10px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded bg-indigo-500/15 text-indigo-300 border border-indigo-500/30">Pro Engine</span>
        </div>
        <p class="text-[11px] text-zinc-400 hidden sm:block">Ubah Script Kode menjadi Animasi Video MP4 60FPS</p>
      </div>
    </div>

    <!-- Preset Selector Bar (Desktop) -->
    <div class="hidden lg:flex items-center gap-1.5 bg-studio-surface p-1 rounded-xl border border-studio-border">
      <button onclick="loadPreset('auroraStars')" data-preset="auroraStars" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all flex items-center gap-1.5 bg-indigo-600 text-white shadow">
        <i data-lucide="sparkles" class="w-3.5 h-3.5"></i> Aurora & Stars Canvas
      </button>
      <button onclick="loadPreset('typingCode')" data-preset="typingCode" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium text-zinc-400 hover:text-white transition-all flex items-center gap-1.5">
        <i data-lucide="terminal" class="w-3.5 h-3.5"></i> Typing Code
      </button>
      <button onclick="loadPreset('kineticType')" data-preset="kineticType" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium text-zinc-400 hover:text-white transition-all flex items-center gap-1.5">
        <i data-lucide="type" class="w-3.5 h-3.5"></i> Kinetic Typography
      </button>
      <button onclick="loadPreset('uiCard')" data-preset="uiCard" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium text-zinc-400 hover:text-white transition-all flex items-center gap-1.5">
        <i data-lucide="layers" class="w-3.5 h-3.5"></i> Animated UI Card
      </button>
      <button onclick="loadPreset('customHtml')" data-preset="customHtml" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium text-zinc-400 hover:text-white transition-all flex items-center gap-1.5">
        <i data-lucide="code-2" class="w-3.5 h-3.5"></i> Custom HTML/CSS
      </button>
    </div>

    <!-- Action Buttons -->
    <div class="flex items-center gap-2">
      <!-- Tombol Cepat Muat Kode Aurora -->
      <button onclick="loadAuroraCode()" title="Muat Ulang Preset Aurora & Twinkling Stars" class="px-3 py-2 rounded-xl bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-500/30 text-emerald-300 text-xs font-semibold flex items-center gap-1.5 transition-all active:scale-95">
        <i data-lucide="moon-star" class="w-3.5 h-3.5"></i>
        <span class="hidden sm:inline">Muat Kode Aurora</span>
      </button>

      <!-- Mobile Preset Dropdown -->
      <select id="mobilePresetSelect" onchange="loadPreset(this.value)" class="lg:hidden bg-studio-surface border border-studio-border text-xs rounded-lg px-2.5 py-2 text-zinc-200 focus:outline-none focus:border-indigo-500">
        <option value="auroraStars">Aurora & Stars Canvas</option>
        <option value="typingCode">Typing Code Effect</option>
        <option value="kineticType">Kinetic Typography</option>
        <option value="uiCard">Animated UI Card</option>
        <option value="customHtml">Custom HTML/CSS Canvas</option>
      </select>

      <button onclick="openExportModal()" id="btnOpenExport" class="bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white text-xs font-semibold px-3.5 py-2 rounded-xl shadow-lg shadow-indigo-600/25 flex items-center gap-2 transition-all active:scale-95">
        <i data-lucide="download" class="w-4 h-4"></i>
        <span>Ekspor MP4</span>
      </button>
    </div>
  </header>

  <!-- MAIN WORKSPACE (SPLIT SCREEN) -->
  <main class="flex-1 flex flex-col lg:flex-row overflow-hidden">

    <!-- LEFT PANEL: CODE & PARAMETER EDITOR -->
    <section class="w-full lg:w-[44%] xl:w-[42%] h-[46%] lg:h-full bg-studio-panel border-b lg:border-b-0 lg:border-r border-studio-border flex flex-col shrink-0">
      
      <!-- Editor Toolbar -->
      <div class="h-10 px-3 bg-studio-surface/70 border-b border-studio-border flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2">
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
          </div>
          <span id="editorFileName" class="text-xs font-mono text-zinc-300 ml-2 flex items-center gap-1.5">
            <i data-lucide="file-code" class="w-3.5 h-3.5 text-indigo-400"></i>
            motion_scene.js
          </span>
        </div>

        <div class="flex items-center gap-1.5">
          <span id="compileStatus" class="text-[11px] text-emerald-400 flex items-center gap-1 px-2 py-0.5 rounded bg-emerald-500/10">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Siap
          </span>
          <button onclick="copyEditorCode()" title="Salin Kode" class="p-1.5 text-zinc-400 hover:text-white hover:bg-zinc-800 rounded-lg transition-colors">
            <i data-lucide="copy" class="w-3.5 h-3.5"></i>
          </button>
          <button onclick="applyAndRestart()" title="Jalankan Ulang Script" class="px-2.5 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-xs font-medium rounded-lg flex items-center gap-1 transition-colors">
            <i data-lucide="play" class="w-3 h-3 text-emerald-400"></i> Terapkan
          </button>
        </div>
      </div>

      <!-- Mode Helper Banner -->
      <div id="modeHelperBanner" class="px-3 py-1.5 bg-indigo-950/40 border-b border-indigo-500/20 text-[11px] text-indigo-200/90 flex items-center justify-between">
        <span id="modeHelperText">Variabel native Canvas 2D: <code class="text-cyan-300 font-mono">ctx, w, h, t, progress</code> (serta alias <code class="text-zinc-300 font-mono">width, height, time, frame</code>).</span>
        <button onclick="showApiDocsModal()" class="text-cyan-400 hover:underline font-medium shrink-0 ml-2">Panduan API</button>
      </div>

      <!-- Panel Parameter Interaktif Opsional (Aurora, Bintang & Overlay Teks) -->
      <div id="motionParamsPanel" class="px-3 py-2 bg-studio-surface/90 border-b border-studio-border space-y-2 shrink-0">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-semibold uppercase tracking-wider text-zinc-400 flex items-center gap-1.5">
            <i data-lucide="sliders-horizontal" class="w-3 h-3 text-indigo-400"></i>
            Parameter Visual & Overlay Motion
          </span>
          <button onclick="resetMotionParams()" class="text-[10px] text-indigo-400 hover:text-indigo-300 font-medium">Reset Default</button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px]">
          <!-- Kecepatan Aurora -->
          <div class="bg-studio-panel/90 border border-studio-border/80 rounded-lg px-2.5 py-1.5">
            <div class="flex justify-between text-zinc-300 mb-1">
              <span>Kecepatan Aurora</span>
              <span id="auroraSpeedVal" class="font-mono text-cyan-400">1.00x</span>
            </div>
            <input id="auroraSpeedSlider" type="range" min="0" max="3" step="0.05" value="1" oninput="updateMotionParams()" class="w-full accent-indigo-500 h-1.5 bg-zinc-800 rounded-lg cursor-pointer" />
          </div>

          <!-- Intensitas Bintang -->
          <div class="bg-studio-panel/90 border border-studio-border/80 rounded-lg px-2.5 py-1.5">
            <div class="flex justify-between text-zinc-300 mb-1">
              <span>Intensitas Bintang</span>
              <span id="starIntensityVal" class="font-mono text-emerald-400">1.00x</span>
            </div>
            <input id="starIntensitySlider" type="range" min="0" max="2.5" step="0.05" value="1" oninput="updateMotionParams()" class="w-full accent-emerald-500 h-1.5 bg-zinc-800 rounded-lg cursor-pointer" />
          </div>
        </div>

        <!-- Overlay Teks / Judul Motion di atas Kanvas -->
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 items-center pt-0.5">
          <div class="sm:col-span-5">
            <input id="overlayTitleInput" type="text" placeholder="Judul Motion (opsional)..." oninput="updateMotionParams()" class="w-full bg-studio-panel border border-studio-border rounded-lg px-2.5 py-1 text-xs text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-indigo-500" />
          </div>
          <div class="sm:col-span-4">
            <input id="overlaySubtitleInput" type="text" placeholder="Subjudul / caption..." oninput="updateMotionParams()" class="w-full bg-studio-panel border border-studio-border rounded-lg px-2.5 py-1 text-xs text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-indigo-500" />
          </div>
          <div class="sm:col-span-3">
            <select id="overlayAlignSelect" onchange="updateMotionParams()" class="w-full bg-studio-panel border border-studio-border rounded-lg px-2 py-1 text-xs text-zinc-200 focus:outline-none focus:border-indigo-500">
              <option value="center" selected>Tengah</option>
              <option value="bottom-left">Kiri Bawah</option>
              <option value="top-left">Kiri Atas</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Code Editor Container dengan Line Numbers -->
      <div class="relative flex-1 flex overflow-hidden bg-[#0d0d11]">
        <div id="lineNumbers" class="w-10 py-3 pr-2 text-right font-mono text-xs text-zinc-600 select-none bg-[#0b0b0f] border-r border-studio-border/60 overflow-hidden leading-[1.6]">1</div>
        <textarea 
          id="codeEditor" 
          spellcheck="false"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          class="code-editor-area flex-1 w-full h-full bg-transparent text-zinc-100 font-mono text-xs p-3 resize-none focus:outline-none overflow-auto whitespace-pre"
        ></textarea>
      </div>

      <!-- Error Log Bar (Tersembunyi jika tidak ada error) -->
      <div id="errorConsole" class="hidden px-3 py-2 bg-rose-950/90 border-t border-rose-500/40 text-rose-200 font-mono text-xs flex items-start gap-2 max-h-24 overflow-y-auto">
        <i data-lucide="alert-triangle" class="w-4 h-4 text-rose-400 shrink-0 mt-0.5"></i>
        <span id="errorText" class="break-all"></span>
      </div>

      <!-- Composition Settings Footer (Resolusi, Durasi, FPS, Kecepatan) -->
      <div class="p-3 bg-studio-panel border-t border-studio-border grid grid-cols-2 sm:grid-cols-4 gap-2.5 shrink-0">
        <!-- Resolusi -->
        <div>
          <label class="block text-[10px] uppercase tracking-wider text-zinc-400 font-semibold mb-1">Resolusi</label>
          <select id="resSelect" onchange="updateSettings()" class="w-full bg-studio-surface border border-studio-border rounded-lg px-2 py-1.5 text-xs text-zinc-200 focus:outline-none focus:border-indigo-500">
            <option value="1080x1080">1080×1080 (1:1)</option>
            <option value="1920x1080" selected>1920×1080 (16:9)</option>
            <option value="1080x1920">1080×1920 (9:16)</option>
          </select>
        </div>

        <!-- Durasi -->
        <div>
          <label class="block text-[10px] uppercase tracking-wider text-zinc-400 font-semibold mb-1">Durasi (Detik)</label>
          <div class="flex items-center bg-studio-surface border border-studio-border rounded-lg px-2 py-1">
            <input id="durationInput" type="number" min="1" max="30" step="0.5" value="5" onchange="updateSettings()" class="w-full bg-transparent text-xs text-zinc-200 focus:outline-none font-mono" />
            <span class="text-[11px] text-zinc-500">dtk</span>
          </div>
        </div>

        <!-- FPS -->
        <div>
          <label class="block text-[10px] uppercase tracking-wider text-zinc-400 font-semibold mb-1">Frame Rate</label>
          <select id="fpsSelect" onchange="updateSettings()" class="w-full bg-studio-surface border border-studio-border rounded-lg px-2 py-1.5 text-xs text-zinc-200 focus:outline-none focus:border-indigo-500 font-mono">
            <option value="30">30 FPS</option>
            <option value="60" selected>60 FPS</option>
          </select>
        </div>

        <!-- Kecepatan -->
        <div>
          <label class="block text-[10px] uppercase tracking-wider text-zinc-400 font-semibold mb-1">Kecepatan</label>
          <select id="speedSelect" onchange="updateSettings()" class="w-full bg-studio-surface border border-studio-border rounded-lg px-2 py-1.5 text-xs text-zinc-200 focus:outline-none focus:border-indigo-500 font-mono">
            <option value="0.5">0.5x Lambat</option>
            <option value="1" selected>1.0x Normal</option>
            <option value="1.5">1.5x Cepat</option>
            <option value="2">2.0x Kilat</option>
          </select>
        </div>
      </div>
    </section>

    <!-- RIGHT PANEL: LIVE PREVIEW VIEWPORT & TIMELINE -->
    <section class="flex-1 h-[54%] lg:h-full flex flex-col bg-studio-bg overflow-hidden relative">
      
      <!-- Viewport Top Info Bar -->
      <div class="h-10 px-4 bg-studio-panel/80 border-b border-studio-border flex items-center justify-between text-xs shrink-0">
        <div class="flex items-center gap-3">
          <span class="text-zinc-400 font-medium flex items-center gap-1.5">
            <i data-lucide="monitor-play" class="w-3.5 h-3.5 text-cyan-400"></i>
            Kanvas Preview
          </span>
          <span id="badgeResolution" class="px-2 py-0.5 rounded-md bg-studio-surface border border-studio-border font-mono text-[11px] text-zinc-300">1920 × 1080</span>
          <span id="badgeAspect" class="hidden sm:inline-block px-2 py-0.5 rounded-md bg-indigo-500/10 border border-indigo-500/20 text-[11px] text-indigo-300">16:9 Landscape</span>
        </div>

        <div class="flex items-center gap-3">
          <label class="flex items-center gap-1.5 cursor-pointer text-zinc-400 hover:text-zinc-200">
            <input id="loopToggle" type="checkbox" checked class="rounded bg-studio-surface border-studio-border text-indigo-500 focus:ring-0" />
            <span>Loop</span>
          </label>
          <span id="zoomLevelText" class="font-mono text-[11px] text-zinc-500">Fit 100%</span>
        </div>
      </div>

      <!-- Canvas Viewport Stage -->
      <div id="viewportContainer" class="flex-1 canvas-backdrop p-4 sm:p-6 flex items-center justify-center overflow-hidden relative">
        <!-- Wrapper bayangan untuk canvas yang proporsional -->
        <div id="canvasFrameWrapper" class="relative shadow-2xl shadow-black/80 ring-1 ring-white/10 rounded-lg overflow-hidden bg-black flex items-center justify-center transition-all duration-200">
          <canvas id="previewCanvas" class="block w-full h-full"></canvas>
        </div>
      </div>

      <!-- TIMELINE & PLAYBACK CONTROLS BAR -->
      <div class="bg-studio-panel border-t border-studio-border px-4 py-3 shrink-0 space-y-2.5">
        
        <!-- Scrubber / Timeline Track -->
        <div class="flex items-center gap-3">
          <span id="currentTimeLabel" class="font-mono text-xs text-indigo-400 font-semibold w-14">00:00.0</span>
          
          <div class="relative flex-1 flex items-center">
            <input 
              id="timelineScrubber" 
              type="range" 
              min="0" 
              max="1000" 
              value="0" 
              class="timeline-slider w-full z-10"
            />
            <!-- Progress Track Visual -->
            <div class="absolute inset-x-0 h-1.5 bg-studio-surface rounded-full overflow-hidden pointer-events-none">
              <div id="timelineProgressFill" class="h-full bg-gradient-to-r from-indigo-500 to-cyan-400 w-0"></div>
            </div>
          </div>

          <span id="totalTimeLabel" class="font-mono text-xs text-zinc-400 w-14 text-right">00:05.0</span>
        </div>

        <!-- Transport Buttons & Frame Counter -->
        <div class="flex items-center justify-between">
          <!-- Left: Frame Info -->
          <div class="hidden sm:flex items-center gap-2 text-[11px] font-mono text-zinc-400">
            <span class="px-2 py-1 rounded bg-studio-surface border border-studio-border">
              Frame: <strong id="frameCounter" class="text-zinc-200">0</strong> / <span id="totalFramesLabel">300</span>
            </span>
          </div>

          <!-- Center: Playback Transport -->
          <div class="flex items-center gap-2 mx-auto sm:mx-0">
            <button onclick="restartAnimation()" title="Ulang dari Awal (Home)" class="p-2 rounded-xl bg-studio-surface hover:bg-zinc-800 border border-studio-border text-zinc-300 hover:text-white transition-all active:scale-95">
              <i data-lucide="skip-back" class="w-4 h-4"></i>
            </button>

            <button onclick="stepFrame(-1)" title="Mundur 1 Frame" class="p-2 rounded-xl bg-studio-surface hover:bg-zinc-800 border border-studio-border text-zinc-300 hover:text-white transition-all active:scale-95">
              <i data-lucide="chevron-left" class="w-4 h-4"></i>
            </button>

            <button id="playPauseBtn" onclick="togglePlay()" class="px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs flex items-center gap-2 shadow-lg shadow-indigo-600/25 transition-all active:scale-95">
              <i id="playPauseIcon" data-lucide="pause" class="w-4 h-4"></i>
              <span id="playPauseText">Jeda</span>
            </button>

            <button onclick="stepFrame(1)" title="Maju 1 Frame" class="p-2 rounded-xl bg-studio-surface hover:bg-zinc-800 border border-studio-border text-zinc-300 hover:text-white transition-all active:scale-95">
              <i data-lucide="chevron-right" class="w-4 h-4"></i>
            </button>
          </div>

          <!-- Right: Quick Export Trigger -->
          <div class="hidden md:flex items-center gap-2">
            <span class="text-[11px] text-zinc-500">Spasi: Play/Pause</span>
          </div>
        </div>
      </div>

    </section>
  </main>

  <!-- MODAL EKSPOR VIDEO MP4 -->
  <div id="exportModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4">
    <div class="bg-studio-panel border border-studio-border rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-5 relative">
      
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-indigo-500/15 border border-indigo-500/30 flex items-center justify-center text-indigo-400">
            <i data-lucide="film" class="w-5 h-5"></i>
          </div>
          <div>
            <h2 class="text-base font-bold text-white">Render & Ekspor Video</h2>
            <p class="text-xs text-zinc-400">Offline Frame-by-Frame Encoder (Anti-Lag)</p>
          </div>
        </div>
        <button id="closeExportBtn" onclick="closeExportModal()" class="p-1.5 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <!-- Ringkasan Spesifikasi Video -->
      <div class="bg-studio-surface border border-studio-border rounded-xl p-3.5 grid grid-cols-2 gap-3 text-xs">
        <div>
          <span class="text-zinc-500 block text-[11px]">Resolusi Output</span>
