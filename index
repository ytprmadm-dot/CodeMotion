  ctx.fillStyle = 'rgba(236, 72, 153, 0.7)';
  ctx.fillText(active.word, -shift, 0);
  ctx.fillStyle = 'rgba(6, 182, 212, 0.7)';
  ctx.fillText(active.word, shift, 0);
}

ctx.fillStyle = '#ffffff';
ctx.fillText(active.word, 0, 0);

const subY = mainFontSize * 0.95;
