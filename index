  grad.addColorStop(0.55, \`rgba(\${b.color}, 0.16)\`);
  grad.addColorStop(1, \`rgba(\${b.color}, 0)\`);

  ctx.fillStyle = grad;
  ctx.beginPath();
  ctx.arc(cx, cy, radius, 0, Math.PI * 2);
  ctx.fill();
