      }
    };

    // =========================================================================
    // 2. STATE APLIKASI & KONFIGURASI STUDIO
    // =========================================================================
    const state = {
      isPlaying: true,
      currentPreset: 'auroraStars',
      mode: 'js', // 'js' atau 'html'
      width: 1920,
      height: 1080,
      duration: 5.0,
      fps: 60,
      speed: 1.0,
      currentTime: 0,
      lastTimestamp: null,
      compiledFn: null,
      isExporting: false,
      params: {
        auroraSpeed: 1.0,
        starIntensity: 1.0,
        title: '',
        subtitle: '',
        align: 'center'
      }
    };

    // =========================================================================
    // 3. REFERENSI DOM & HELPER EASING / GEOMETRI CANVAS
    // =========================================================================
    const codeEditor = document.getElementById('codeEditor');
    const lineNumbers = document.getElementById('lineNumbers');
    const timelineScrubber = document.getElementById('timelineScrubber');
    const canvas = document.getElementById('previewCanvas');
    const ctx = canvas.getContext('2d');

    const helpers = {
      easeOutCubic: (x) => 1 - Math.pow(1 - Math.max(0, Math.min(1, x)), 3),
      easeInOutCubic: (x) => {
        const t = Math.max(0, Math.min(1, x));
        return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      },
      easeOutElastic: (x) => {
        const t = Math.max(0, Math.min(1, x));
        if (t === 0 || t === 1) return t;
        const c4 = (2 * Math.PI) / 3;
        return Math.pow(2, -10 * t) * Math.sin((t * 10 - 0.75) * c4) + 1;
      },
      easeOutBounce: (x) => {
        let t = Math.max(0, Math.min(1, x));
        const n1 = 7.5625;
        const d1 = 2.75;
        if (t < 1 / d1) return n1 * t * t;
        if (t < 2 / d1) return n1 * (t -= 1.5 / d1) * t + 0.75;
        if (t < 2.5 / d1) return n1 * (t -= 2.25 / d1) * t + 0.9375;
        return n1 * (t -= 2.625 / d1) * t + 0.984375;
      },
      roundRect: (c, x, y, w, h, r) => {
        const rad = Math.min(r, Math.abs(w) / 2, Math.abs(h) / 2);
        c.beginPath();
        c.moveTo(x + rad, y);
        c.arcTo(x + w, y, x + w, y + h, rad);
        c.arcTo(x + w, y + h, x, y + h, rad);
        c.arcTo(x, y + h, x, y, rad);
        c.arcTo(x, y, x + w, y, rad);
        c.closePath();
      },
      roundRectTop: (c, x, y, w, h, r) => {
        const rad = Math.min(r, Math.abs(w) / 2, Math.abs(h) / 2);
        c.beginPath();
        c.moveTo(x, y + h);
        c.lineTo(x, y + rad);
        c.arcTo(x, y, x + rad, y, rad);
        c.lineTo(x + w - rad, y);
        c.arcTo(x + w, y, x + w, y + rad, rad);
        c.lineTo(x + w, y + h);
        c.closePath();
      }
    };

    // =========================================================================
    // 4. INISIALISASI & KOMPILASI KODE EDITOR
    // =========================================================================
    function init() {
      lucide.createIcons();
      loadPreset('auroraStars');
      updateCanvasDimensions();
      window.addEventListener('resize', fitCanvasToViewport);
      
      // Event Listeners Editor
      codeEditor.addEventListener('input', () => {
        updateLineNumbers();
        compileUserCode();
      });
      codeEditor.addEventListener('scroll', () => {
        lineNumbers.scrollTop = codeEditor.scrollTop;
      });
      codeEditor.addEventListener('keydown', (e) => {
        if (e.key === 'Tab') {
          e.preventDefault();
          const start = codeEditor.selectionStart;
          const end = codeEditor.selectionEnd;
          codeEditor.value = codeEditor.value.substring(0, start) + '  ' + codeEditor.value.substring(end);
          codeEditor.selectionStart = codeEditor.selectionEnd = start + 2;
          updateLineNumbers();
        }
      });

      // Timeline Scrubber
      timelineScrubber.addEventListener('input', (e) => {
        const ratio = parseFloat(e.target.value) / 1000;
        state.currentTime = ratio * state.duration;
        renderFrameAtTime(state.currentTime);
        updateTimelineUI();
      });

      // Keyboard Shortcut Spasi untuk Play/Pause (di luar textarea)
      window.addEventListener('keydown', (e) => {
        if (e.code === 'Space' && document.activeElement !== codeEditor && document.activeElement.tagName !== 'INPUT') {
          e.preventDefault();
          togglePlay();
        }
      });

      // Mulai Loop Animasi
      requestAnimationFrame(animationLoop);
    }

    function loadPreset(presetKey) {
      const preset = PRESETS[presetKey];
      if (!preset) return;

      state.currentPreset = presetKey;
      state.mode = preset.mode;
      codeEditor.value = preset.code;
      document.getElementById('editorFileName').innerHTML = `<i data-lucide="file-code" class="w-3.5 h-3.5 text-indigo-400"></i> ${preset.name}`;
      document.getElementById('mobilePresetSelect').value = presetKey;

      // Update style tombol preset aktif
      document.querySelectorAll('.preset-btn').forEach(btn => {
        if (btn.dataset.preset === presetKey) {
          btn.className = 'preset-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all flex items-center gap-1.5 bg-indigo-600 text-white shadow';
        } else {
          btn.className = 'preset-btn px-3 py-1.5 rounded-lg text-xs font-medium text-zinc-400 hover:text-white transition-all flex items-center gap-1.5';
        }
      });

      lucide.createIcons();
      updateLineNumbers();
      compileUserCode();
      restartAnimation();
    }

    function loadAuroraCode() {
      loadPreset('auroraStars');
      showToast('Kode Aurora & Twinkling Stars dimuat ke editor!');
    }

    function updateMotionParams() {
      const auroraSpeed = parseFloat(document.getElementById('auroraSpeedSlider').value) || 1.0;
      const starIntensity = parseFloat(document.getElementById('starIntensitySlider').value) || 1.0;
      const title = document.getElementById('overlayTitleInput').value.trim();
      const subtitle = document.getElementById('overlaySubtitleInput').value.trim();
      const align = document.getElementById('overlayAlignSelect').value;

      state.params = { auroraSpeed, starIntensity, title, subtitle, align };

      document.getElementById('auroraSpeedVal').textContent = `${auroraSpeed.toFixed(2)}x`;
      document.getElementById('starIntensityVal').textContent = `${starIntensity.toFixed(2)}x`;

      if (!state.isPlaying) {
        renderFrameAtTime(state.currentTime);
      }
    }

    function resetMotionParams() {
      document.getElementById('auroraSpeedSlider').value = 1;
      document.getElementById('starIntensitySlider').value = 1;
      document.getElementById('overlayTitleInput').value = '';
      document.getElementById('overlaySubtitleInput').value = '';
      document.getElementById('overlayAlignSelect').value = 'center';
      updateMotionParams();
      showToast('Parameter visual direset ke default.');
    }

    function renderTextOverlay(progress, timeSec) {
      const { title, subtitle, align } = state.params;
      if (!title && !subtitle) return;

      const enter = easeOutCubic(Math.min(progress * 3.5, 1));
      const scaleFactor = Math.min(w_or_h(), 1920) / 1080;
      const padX = Math.max(48, state.width * 0.06);
      const padY = Math.max(48, state.height * 0.08);

      let x = state.width / 2;
      let y = state.height / 2;
      let textAlign = 'center';

      if (align === 'bottom-left') {
        x = padX;
        y = state.height - padY;
        textAlign = 'left';
      } else if (align === 'top-left') {
        x = padX;
        y = padY + 48 * scaleFactor;
        textAlign = 'left';
      }

      ctx.save();
      ctx.globalAlpha = enter;
      ctx.textAlign = textAlign;
      ctx.textBaseline = 'middle';

      const yOffset = (1 - enter) * 24;
      const titleSize = Math.max(28, Math.round(64 * scaleFactor));
      const subSize = Math.max(16, Math.round(26 * scaleFactor));

      ctx.shadowColor = 'rgba(0, 0, 0, 0.65)';
      ctx.shadowBlur = 24;

      if (title && subtitle) {
        const titleY = align === 'bottom-left' ? y - subSize * 1.45 + yOffset : y - subSize * 0.65 + yOffset;
        const subY = align === 'bottom-left' ? y + yOffset : y + titleSize * 0.75 + yOffset;

        ctx.font = `800 ${titleSize}px "Inter", sans-serif`;
        ctx.fillStyle = '#ffffff';
        ctx.fillText(title, x, titleY);

        ctx.font = `500 ${subSize}px "Inter", sans-serif`;
        ctx.fillStyle = 'rgba(224, 242, 254, 0.88)';
        ctx.fillText(subtitle, x, subY);
      } else if (title) {
        ctx.font = `800 ${titleSize}px "Inter", sans-serif`;
        ctx.fillStyle = '#ffffff';
        ctx.fillText(title, x, y + yOffset);
      } else if (subtitle) {
        ctx.font = `600 ${subSize}px "Inter", sans-serif`;
        ctx.fillStyle = '#e0f2fe';
        ctx.fillText(subtitle, x, y + yOffset);
      }

      ctx.restore();
    }

    function w_or_h() {
      return Math.min(state.width, state.height);
    }

    function updateLineNumbers() {
      const lines = codeEditor.value.split('\n').length;
      lineNumbers.innerHTML = Array.from({ length: lines }, (_, i) => i + 1).join('<br>');
    }

    function compileUserCode() {
      const rawCode = codeEditor.value.trim();
      const errorConsole = document.getElementById('errorConsole');
      const errorText = document.getElementById('errorText');
      const compileStatus = document.getElementById('compileStatus');

      // Deteksi otomatis apakah mode HTML/CSS atau JS Canvas
      if (rawCode.startsWith('<')) {
        state.mode = 'html';
        errorConsole.classList.add('hidden');
        compileStatus.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span> Mode HTML/CSS`;
        compileStatus.className = 'text-[11px] text-cyan-300 flex items-center gap-1 px-2 py-0.5 rounded bg-cyan-500/10';
        if (!state.isPlaying) renderFrameAtTime(state.currentTime);
        return;
      }

      state.mode = 'js';
      try {
        // Buat fungsi terisolasi dengan variabel native ctx, w, h, t, progress (+ alias & params)
        const fn = new Function(
          'ctx', 'w', 'h', 't', 'progress',
          'width', 'height', 'time', 'frame', 'params',
          'easeOutCubic', 'easeInOutCubic', 'easeOutElastic', 'easeOutBounce',
          'roundRect', 'roundRectTop',
          rawCode
        );
        state.compiledFn = fn;
        errorConsole.classList.add('hidden');
        compileStatus.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Aktif`;
        compileStatus.className = 'text-[11px] text-emerald-400 flex items-center gap-1 px-2 py-0.5 rounded bg-emerald-500/10';
        
        if (!state.isPlaying) renderFrameAtTime(state.currentTime);
      } catch (err) {
        errorText.textContent = `Syntax Error: ${err.message}`;
        errorConsole.classList.remove('hidden');
        compileStatus.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span> Error`;
        compileStatus.className = 'text-[11px] text-rose-400 flex items-center gap-1 px-2 py-0.5 rounded bg-rose-500/10';
      }
    }

    function applyAndRestart() {
      compileUserCode();
      restartAnimation();
      showToast('Script berhasil diterapkan ke kanvas!');
    }

    // =========================================================================
    // 5. PENGATURAN RESOLUSI, DURASI & FIT VIEWPORT
    // =========================================================================
    function updateSettings() {
      const [w, h] = document.getElementById('resSelect').value.split('x').map(Number);
      state.width = w;
      state.height = h;
      state.duration = Math.max(1, Math.min(30, parseFloat(document.getElementById('durationInput').value) || 5));
      state.fps = parseInt(document.getElementById('fpsSelect').value, 10);
      state.speed = parseFloat(document.getElementById('speedSelect').value);

      if (state.currentTime > state.duration) state.currentTime = 0;

      // Update label UI
      document.getElementById('badgeResolution').textContent = `${w} × ${h}`;
      const aspectLabel = w === h ? '1:1 Square' : (w > h ? '16:9 Landscape' : '9:16 Reels/TikTok');
      document.getElementById('badgeAspect').textContent = aspectLabel;

      updateCanvasDimensions();
      updateTimelineUI();
      renderFrameAtTime(state.currentTime);
    }

    function updateCanvasDimensions() {
      canvas.width = state.width;
      canvas.height = state.height;
      fitCanvasToViewport();
    }

    function fitCanvasToViewport() {
      const container = document.getElementById('viewportContainer');
      const wrapper = document.getElementById('canvasFrameWrapper');
      if (!container || !wrapper) return;

      const availW = container.clientWidth - 32;
      const availH = container.clientHeight - 32;
      const scale = Math.min(availW / state.width, availH / state.height, 1);

      wrapper.style.width = `${Math.floor(state.width * scale)}px`;
      wrapper.style.height = `${Math.floor(state.height * scale)}px`;
      document.getElementById('zoomLevelText').textContent = `Zoom ${Math.round(scale * 100)}%`;
    }

    // =========================================================================
    // 6. ENGINE RENDERING FRAME (JS CANVAS & HTML SVG FOREIGNOBJECT)
    // =========================================================================
    function renderFrameAtTime(timeSec) {
      const progress = Math.min(Math.max(timeSec / state.duration, 0), 1);
      const frameIndex = Math.floor(timeSec * state.fps);

      if (state.mode === 'js') {
        if (!state.compiledFn) return;
        try {
          ctx.save();
          state.compiledFn(
            ctx, state.width, state.height, timeSec, progress,
            state.width, state.height, timeSec, frameIndex, state.params,
            helpers.easeOutCubic, helpers.easeInOutCubic, helpers.easeOutElastic, helpers.easeOutBounce,
            helpers.roundRect, helpers.roundRectTop
          );
          ctx.restore();
          renderTextOverlay(progress, timeSec);
        } catch (runtimeErr) {
          ctx.restore();
          const errorConsole = document.getElementById('errorConsole');
          document.getElementById('errorText').textContent = `Runtime Error: ${runtimeErr.message}`;
          errorConsole.classList.remove('hidden');
        }
      } else if (state.mode === 'html') {
        renderHtmlToCanvas(progress);
      }
    }

    function renderHtmlToCanvas(progress) {
      const htmlContent = codeEditor.value;
      const svgMarkup = `
        <svg xmlns="http://www.w3.org/2000/svg" width="${state.width}" height="${state.height}">
          <foreignObject width="100%" height="100%">
            <div xmlns="http://www.w3.org/1999/xhtml" style="width:${state.width}px;height:${state.height}px;--progress:${progress.toFixed(4)};">
              ${htmlContent}
            </div>
          </foreignObject>
        </svg>
      `;

      const img = new Image();
      const svgBlob = new Blob([svgMarkup], { type: 'image/svg+xml;charset=utf-8' });
      const url = URL.createObjectURL(svgBlob);

      img.onload = () => {
        ctx.clearRect(0, 0, state.width, state.height);
        ctx.drawImage(img, 0, 0, state.width, state.height);
        URL.revokeObjectURL(url);
      };
      img.src = url;
    }

    // Versi Promise untuk ekspor offline mode HTML
    function renderHtmlToCanvasAsync(progress) {
      return new Promise((resolve) => {
        const htmlContent = codeEditor.value;
        const svgMarkup = `
          <svg xmlns="http://www.w3.org/2000/svg" width="${state.width}" height="${state.height}">
            <foreignObject width="100%" height="100%">
              <div xmlns="http://www.w3.org/1999/xhtml" style="width:${state.width}px;height:${state.height}px;--progress:${progress.toFixed(4)};">
                ${htmlContent}
              </div>
            </foreignObject>
          </svg>
        `;
        const img = new Image();
        const svgBlob = new Blob([svgMarkup], { type: 'image/svg+xml;charset=utf-8' });
        const url = URL.createObjectURL(svgBlob);
        img.onload = () => {
          ctx.clearRect(0, 0, state.width, state.height);
          ctx.drawImage(img, 0, 0, state.width, state.height);
          URL.revokeObjectURL(url);
          resolve();
        };
        img.onerror = () => {
          URL.revokeObjectURL(url);
          resolve();
        };
        img.src = url;
      });
    }

    // =========================================================================
    // 7. ANIMATION PLAYBACK LOOP & TIMELINE CONTROLS
    // =========================================================================
    function animationLoop(timestamp) {
      if (!state.lastTimestamp) state.lastTimestamp = timestamp;
      const deltaSec = (timestamp - state.lastTimestamp) / 1000;
      state.lastTimestamp = timestamp;

      if (state.isPlaying && !state.isExporting) {
        state.currentTime += deltaSec * state.speed;

        if (state.currentTime >= state.duration) {
          const isLoop = document.getElementById('loopToggle').checked;
          if (isLoop) {
            state.currentTime = state.currentTime % state.duration;
          } else {
            state.currentTime = state.duration;
            state.isPlaying = false;
            updatePlayButtonUI();
          }
        }

        renderFrameAtTime(state.currentTime);
        updateTimelineUI();
      }

      requestAnimationFrame(animationLoop);
    }

    function updateTimelineUI() {
      const ratio = Math.min(Math.max(state.currentTime / state.duration, 0), 1);
      timelineScrubber.value = Math.round(ratio * 1000);
      timelineProgressFill.style.width = `${ratio * 100}%`;

      document.getElementById('currentTimeLabel').textContent = formatTime(state.currentTime);
      document.getElementById('totalTimeLabel').textContent = formatTime(state.duration);

      const currentFrame = Math.floor(state.currentTime * state.fps);
      const totalFrames = Math.floor(state.duration * state.fps);
      document.getElementById('frameCounter').textContent = currentFrame;
      document.getElementById('totalFramesLabel').textContent = totalFrames;
    }

    function formatTime(sec) {
      const mins = Math.floor(sec / 60);
      const secs = Math.floor(sec % 60);
      const tenths = Math.floor((sec % 1) * 10);
      return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}.${tenths}`;
    }

    function togglePlay() {
      if (state.currentTime >= state.duration && !state.isPlaying) {
        state.currentTime = 0;
      }
      state.isPlaying = !state.isPlaying;
      state.lastTimestamp = performance.now();
      updatePlayButtonUI();
    }

    function updatePlayButtonUI() {
      const icon = document.getElementById('playPauseIcon');
      const text = document.getElementById('playPauseText');
      if (state.isPlaying) {
        icon.setAttribute('data-lucide', 'pause');
        text.textContent = 'Jeda';
      } else {
        icon.setAttribute('data-lucide', 'play');
        text.textContent = 'Putar';
      }
      lucide.createIcons();
    }

    function restartAnimation() {
      state.currentTime = 0;
      state.lastTimestamp = performance.now();
      renderFrameAtTime(0);
      updateTimelineUI();
    }

    function stepFrame(direction) {
      state.isPlaying = false;
      updatePlayButtonUI();
      const frameDur = 1 / state.fps;
      state.currentTime = Math.min(Math.max(state.currentTime + direction * frameDur, 0), state.duration);
      renderFrameAtTime(state.currentTime);
      updateTimelineUI();
    }

    // =========================================================================
    // 8. EKSPOR MP4 FRAME-BY-FRAME (WEBCODECS + MP4-MUXER + FALLBACK)
    // =========================================================================
    function openExportModal() {
      state.isPlaying = false;
      updatePlayButtonUI();

      const totalFrames = Math.ceil(state.duration * state.fps);
      document.getElementById('exportSpecRes').textContent = `${state.width} × ${state.height} px`;
      document.getElementById('exportSpecDur').textContent = `${state.duration.toFixed(1)} dtk @ ${state.fps} FPS`;
      document.getElementById('exportSpecFrames').textContent = `${totalFrames} Frames`;

      const hasWebCodecs = typeof VideoEncoder !== 'undefined' && typeof Mp4Muxer !== 'undefined';
      document.getElementById('exportSpecCodec').textContent = hasWebCodecs
        ? 'H.264 MP4 (WebCodecs Hardware)'
        : 'WebM/MP4 (MediaRecorder)';

      // Reset tampilan modal
      document.getElementById('exportOptionsSection').classList.remove('hidden');
      document.getElementById('exportActionButtons').classList.remove('hidden');
      document.getElementById('renderProgressBox').classList.add('hidden');
      document.getElementById('renderCompleteBox').classList.add('hidden');

      const modal = document.getElementById('exportModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeExportModal() {
      if (state.isExporting) return;
      const modal = document.getElementById('exportModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    async function startVideoExport() {
      if (state.isExporting) return;
      state.isExporting = true;

      // UI Progress State
      document.getElementById('exportOptionsSection').classList.add('hidden');
      document.getElementById('exportActionButtons').classList.add('hidden');
      document.getElementById('closeExportBtn').classList.add('hidden');
      document.getElementById('renderProgressBox').classList.remove('hidden');

      const bitrate = parseInt(document.getElementById('bitrateSelect').value, 10);
      const hasWebCodecs = typeof VideoEncoder !== 'undefined' && typeof Mp4Muxer !== 'undefined';

      try {
        if (hasWebCodecs) {
          await exportWithWebCodecsMP4(bitrate);
        } else {
          await exportWithMediaRecorderFallback(bitrate);
        }
      } catch (err) {
        console.warn('WebCodecs gagal, beralih ke MediaRecorder fallback:', err);
        await exportWithMediaRecorderFallback(bitrate);
      } finally {
        state.isExporting = false;
        document.getElementById('closeExportBtn').classList.remove('hidden');
      }
    }

    // METODE UTAMA: Offline Frame-by-Frame Rendering ke MP4 asli (H.264)
    async function exportWithWebCodecsMP4(bitrate) {
      const width = state.width;
      const height = state.height;
      const fps = state.fps;
      const totalFrames = Math.ceil(state.duration * fps);

      // Inisialisasi MP4 Muxer
      const muxer = new Mp4Muxer.Muxer({
        target: new Mp4Muxer.ArrayBufferTarget(),
        video: {
          codec: 'avc',
          width: width,
          height: height
        },
        fastStart: 'in-memory'
      });

      const videoEncoder = new VideoEncoder({
        output: (chunk, meta) => muxer.addVideoChunk(chunk, meta),
        error: (e) => { throw e; }
      });

      // Pilih profil AVC yang mendukung resolusi hingga 1080p/4K
      const codecString = width * height > 1280 * 720 ? 'avc1.640028' : 'avc1.4d002a';
      videoEncoder.configure({
        codec: codecString,
        width: width,
        height: height,
        bitrate: bitrate,
        framerate: fps
      });

      const startTime = performance.now();

      for (let i = 0; i < totalFrames; i++) {
        const simTime = (i / fps);
        const progress = Math.min(simTime / state.duration, 1);

        // Render frame akurat ke canvas
        if (state.mode === 'html') {
          await renderHtmlToCanvasAsync(progress);
        } else {
          renderFrameAtTime(simTime);
        }

        // Tangkap frame sebagai VideoFrame WebCodecs
        const timestampMicros = Math.round((i / fps) * 1_000_000);
        const durationMicros = Math.round((1 / fps) * 1_000_000);
        const frame = new VideoFrame(canvas, {
          timestamp: timestampMicros,
          duration: durationMicros
        });

        const keyFrame = i % (fps * 2) === 0;
        videoEncoder.encode(frame, { keyFrame });
        frame.close();

        // Update progress bar setiap beberapa frame agar UI tetap responsif
        if (i % 3 === 0 || i === totalFrames - 1) {
          const pct = Math.round(((i + 1) / totalFrames) * 100);
          const elapsed = (performance.now() - startTime) / 1000;
          const eta = i > 0 ? Math.max(0, (elapsed / (i + 1)) * (totalFrames - i - 1)).toFixed(1) : '...';

          document.getElementById('renderProgressBar').style.width = `${pct}%`;
          document.getElementById('renderPercentLabel').textContent = `${pct}%`;
          document.getElementById('renderFrameDetail').textContent = `Frame ${i + 1} / ${totalFrames}`;
          document.getElementById('renderEtaLabel').textContent = `Sisa waktu: ~${eta} dtk`;

          // Beri jeda microtask agar browser dapat me-repaint UI
          await new Promise(r => setTimeout(r, 0));
        }
      }

      document.getElementById('renderStatusLabel').textContent = 'Membungkus kontainer MP4...';
      await videoEncoder.flush();
      muxer.finalize();

      const { buffer } = muxer.target;
      const blob = new Blob([buffer], { type: 'video/mp4' });
      finishExportUI(blob, 'mp4');
    }

    // METODE FALLBACK: Jika browser lama tidak mendukung WebCodecs
    async function exportWithMediaRecorderFallback(bitrate) {
      const fps = state.fps;
      const totalFrames = Math.ceil(state.duration * fps);
      const stream = canvas.captureStream(fps);
      const mimeType = MediaRecorder.isTypeSupported('video/mp4') ? 'video/mp4' : 'video/webm;codecs=vp9';
      const recorder = new MediaRecorder(stream, { mimeType, videoBitsPerSecond: bitrate });
      const chunks = [];

      recorder.ondataavailable = (e) => { if (e.data.size > 0) chunks.push(e.data); };

      const donePromise = new Promise(resolve => {
        recorder.onstop = () => resolve(new Blob(chunks, { type: mimeType }));
      });

      recorder.start();

      for (let i = 0; i < totalFrames; i++) {
        const simTime = i / fps;
        renderFrameAtTime(simTime);

        const pct = Math.round(((i + 1) / totalFrames) * 100);
        document.getElementById('renderProgressBar').style.width = `${pct}%`;
        document.getElementById('renderPercentLabel').textContent = `${pct}%`;
        document.getElementById('renderFrameDetail').textContent = `Frame ${i + 1} / ${totalFrames}`;

        await new Promise(r => setTimeout(r, 1000 / fps));
      }

      recorder.stop();
      const blob = await donePromise;
      const ext = mimeType.includes('mp4') ? 'mp4' : 'webm';
      finishExportUI(blob, ext);
    }

    function finishExportUI(blob, ext) {
      const url = URL.createObjectURL(blob);
      const sizeMB = (blob.size / (1024 * 1024)).toFixed(2);
      const fileName = `codemotion_${state.currentPreset}_${state.width}x${state.height}.${ext}`;

      const dlLink = document.getElementById('downloadVideoLink');
      dlLink.href = url;
      dlLink.download = fileName;
      dlLink.querySelector('span').textContent = `Unduh Video (.${ext.toUpperCase()})`;

      document.getElementById('renderedFileSize').textContent = `${fileName} (${sizeMB} MB)`;
      document.getElementById('renderProgressBox').classList.add('hidden');
      document.getElementById('renderCompleteBox').classList.remove('hidden');
      lucide.createIcons();
    }

    // =========================================================================
    // 9. UTILITAS UI (CLIPBOARD, MODALS, TOAST)
    // =========================================================================
    function copyEditorCode() {
      codeEditor.select();
      document.execCommand('copy');
      window.getSelection().removeAllRanges();
      showToast('Kode berhasil disalin ke clipboard!');
    }

    function showApiDocsModal() {
      const modal = document.getElementById('apiDocsModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeApiDocsModal() {
      const modal = document.getElementById('apiDocsModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function showToast(msg) {
      const toast = document.getElementById('toastNotification');
      document.getElementById('toastMessage').textContent = msg;
      toast.classList.remove('translate-y-20', 'opacity-0');
      setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 2800);
    }

    window.onload = init;
  </script>
</body>
