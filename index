}

const scenes = [
  { word: "TULIS KODE.", sub: "DARI IDE MENJADI REALITA", accent: "#6366f1", start: 0.0, end: 0.34 },
  { word: "GERAKKAN.", sub: "ANIMASI PRESISI 60 FPS", accent: "#06b6d4", start: 0.34, end: 0.68 },
  { word: "EKSPOR MP4.", sub: "SIAP TAYANG DI MANA SAJA", accent: "#ec4899", start: 0.68, end: 1.0 }
];

const active = scenes.find(s => progress >= s.start && progress <= s.end) || scenes[scenes.length - 1];
const localP = (progress - active.start) / (active.end - active.start);

const popIn = easeOutElastic(Math.min(localP * 2.5, 1));
const fadeOut = localP > 0.82 ? 1 - ((localP - 0.82) / 0.18) : 1;

ctx.save();
ctx.translate(w / 2, h / 2);
ctx.globalAlpha = Math.max(0, fadeOut);

const circleRadius = Math.min(w, h) * 0.28 * popIn;
const radGrad = ctx.createRadialGradient(0, 0, 10, 0, 0, circleRadius);
radGrad.addColorStop(0, active.accent + '55');
radGrad.addColorStop(1, 'transparent');
ctx.fillStyle = radGrad;
ctx.beginPath();
ctx.arc(0, 0, circleRadius, 0, Math.PI * 2);
