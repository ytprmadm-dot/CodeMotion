  const cx = (b.x + Math.cos(auroraTime * b.speed + b.phase) * 0.18) * w;
  const cy = (b.y + Math.sin(auroraTime * b.speed * 0.75 + b.phase) * 0.12) * h;
  const radius = b.r * Math.max(w, h) * (0.92 + 0.14 * Math.cos(auroraTime * 1.1 + b.phase));

